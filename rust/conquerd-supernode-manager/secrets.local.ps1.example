# Copy to secrets.local.ps1 (gitignored) and fill in your SSH credentials.
#
# Servers themselves live in inventory.toml as [[host]] blocks; this file only
# supplies the login for each of them.
#
# Per-host variables are keyed by the [[host]].name from inventory.toml,
# uppercased with every non-alphanumeric character replaced by "_"
# (host "acdc" -> _ACDC, host "edge-1-a" -> _EDGE_1_A).

# --- Fallbacks, used by any host without its own entry below -----------------
$env:SNM_SSH_PASSWORD = "your-password-here"
# $env:SNM_SSH_USER   = "root"   # only fills in when a host's ssh string has no "user@"

# --- Per-host credentials ----------------------------------------------------
# [[host]] name = "acdc", ssh = "root@155.138.244.189"
# $env:SNM_SSH_PASSWORD_ACDC = "acdc-password"

# [[host]] name = "ac1" — SNM_SSH_USER_* overrides the "user@" in inventory.toml
# $env:SNM_SSH_USER_AC1     = "conquerd"
# $env:SNM_SSH_PASSWORD_AC1 = "ac1-password"

# Hosts you reach with an SSH key need no entry at all: key auth is tried first
# and passwords are never sent. Passwords also apply only to the default
# embedded backend — under SNM_SSH_BACKEND=openssh the system ssh client
# handles auth, so put those credentials in ~/.ssh/config instead.
