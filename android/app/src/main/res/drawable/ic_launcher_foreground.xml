<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: the "D://" mark from @drawable/ic_logo, same geometry,
  scaled into the adaptive-icon canvas.

  Of the 108x108 canvas only the inner 72dp survives the launcher mask, and a
  circular mask keeps only a 72dp-diameter circle of that. A 64x29 mark is the
  largest the wordmark's 122:56 aspect fits inside that circle, so nothing is
  clipped whichever mask a launcher applies.

    scale     = 64 / 122 = 0.5246   ->  drawn size 64 x 29.4
    translate = ((108 - 64) / 2, (108 - 29.4) / 2)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.5246"
        android:scaleY="0.5246"
        android:translateX="22"
        android:translateY="39.31">

        <path
            android:fillColor="@color/logo"
            android:fillType="evenOdd"
            android:pathData="M0,0 L36,0 L48,28 L36,56 L0,56 Z M11,11 L28,11 L37,28 L28,45 L11,45 Z" />
        <path
            android:fillColor="@color/logo"
            android:pathData="M59,17 L65,17 A1,1 0 0 1 66,18 L66,24 A1,1 0 0 1 65,25 L59,25 A1,1 0 0 1 58,24 L58,18 A1,1 0 0 1 59,17 Z" />
        <path
            android:fillColor="@color/logo"
            android:pathData="M59,41 L65,41 A1,1 0 0 1 66,42 L66,48 A1,1 0 0 1 65,49 L59,49 A1,1 0 0 1 58,48 L58,42 A1,1 0 0 1 59,41 Z" />
        <path
            android:fillColor="@color/logo"
            android:pathData="M76,56 L87,56 L105,0 L94,0 Z" />
        <path
            android:fillColor="@color/logo"
            android:pathData="M92,56 L103,56 L121,0 L110,0 Z" />
    </group>
</vector>
