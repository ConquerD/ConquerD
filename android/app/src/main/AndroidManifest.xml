<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QUIC to peers and supernodes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The core has to outlive the visible activity: a peer-to-peer client that
      dies when the screen turns off cannot hold a session or receive a
      message. There is no central push server, so the honest foreground type
      for "keep the QUIC session alive" is specialUse — dataSync is a 6-hour
      user-initiated transfer bucket and Play rejects using it as a socket.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Voice calls. From Android 14 a foreground service that captures audio
      must declare the `microphone` type as well, and the service may only
      claim that type once RECORD_AUDIO has actually been granted - so the
      service starts as `specialUse` and upgrades when a call begins.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Lock-screen incoming call. Play Console needs a calling-app declaration. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Video calls. Camera capture is opt-in per call, same as the mic. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConquerD">

        <!--
          allowBackup is off deliberately: the identity key and the chat
          database are on-device secrets, and cloud backup would copy them off
          the device the whole trust model says they never leave.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Invite links open straight into the app. The https form is what
                gets shared (chat clients only linkify http(s)); autoVerify
                routes it without a chooser once /.well-known/assetlinks.json
                on doubleslash.space lists this package and signing cert.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="doubleslash.space" android:pathPrefix="/i" />
                <data android:scheme="https" android:host="doubleslash.space" android:pathPrefix="/r" />
                <data android:scheme="https" android:host="www.doubleslash.space" android:pathPrefix="/i" />
                <data android:scheme="https" android:host="www.doubleslash.space" android:pathPrefix="/r" />
            </intent-filter>
            <!-- Hand-off from the landing page when App Links cannot route. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doubleslash" />
                <data android:scheme="d" />
            </intent-filter>
        </activity>

        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds invite-only peer-to-peer QUIC sessions so messages and calls can arrive without a central push server. Runs only while the identity is unlocked; stop from the notification or by locking in the app." />
        </service>
    </application>
</manifest>
