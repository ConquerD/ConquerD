<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DoubleSlash macOS application bundle Info.plist template.
  ========================================================
  The build script substitutes @VERSION@ with the current APP_VERSION_STRING.

  CFBundleURLTypes registers the d:// URI scheme (and legacy conquerd://)
  so clicking an invite link in a browser launches DoubleSlash with the
  URL as argv[1].
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>DoubleSlash</string>

    <key>CFBundleDisplayName</key>
    <string>DoubleSlash</string>

    <key>CFBundleIdentifier</key>
    <string>com.conquerd.app</string>

    <key>CFBundleVersion</key>
    <string>@VERSION@</string>

    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>

    <key>CFBundleExecutable</key>
    <string>conquerd</string>

    <key>CFBundleIconFile</key>
    <string>conquerd.icns</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSMicrophoneUsageDescription</key>
    <string>DoubleSlash needs microphone access for voice calls.</string>

    <!-- d:// URI scheme registration (legacy conquerd:// kept) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>DoubleSlash Protocol</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>d</string>
                <string>conquerd</string>
            </array>
        </dict>
    </array>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
</dict>
</plist>
